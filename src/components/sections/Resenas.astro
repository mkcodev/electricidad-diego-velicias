---
import Section from '@ui/Section.astro';
import SectionHeading from '@ui/SectionHeading.astro';
import Icon from '@ui/Icon.astro';
import { RESENAS } from '@data/site';

// 🟡 TODO: sustituir RESENAS por reseñas reales de Google Business.
// Mientras haya placeholders (texto empieza con 🟡) este bloque no se muestra en producción.
const hayResenasReales = RESENAS.some((r) => !r.texto.startsWith('🟡'));
---

{hayResenasReales ? (
  <Section bg="white">
    <SectionHeading eyebrow="Opiniones" title="Lo que dicen mis clientes" center />
    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      {RESENAS.filter((r) => !r.texto.startsWith('🟡')).map((r) => (
        <article class="card p-6 flex flex-col gap-4">
          <div class="flex gap-0.5" aria-label={`${r.estrellas} estrellas`}>
            {Array.from({ length: r.estrellas }).map(() => (
              <Icon name="Star" class="w-4 h-4 text-brand-yellow fill-brand-yellow" />
            ))}
          </div>
          <p class="text-sm text-brand-gray leading-relaxed flex-1">"{r.texto}"</p>
          <footer class="border-t border-brand-gray-border pt-3">
            <p class="font-semibold text-sm">{r.nombre}</p>
            <p class="text-xs text-brand-gray flex items-center gap-1 mt-0.5">
              <Icon name="MapPin" class="w-3 h-3" /> {r.lugar}
            </p>
          </footer>
        </article>
      ))}
    </div>
  </Section>
) : null}
