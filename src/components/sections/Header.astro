---
import { Image } from 'astro:assets';
import { SITE, NAV } from '@data/site';
import Button from '@ui/Button.astro';
import Icon from '@ui/Icon.astro';
import logoBlack from '@assets/logo/logo-black.png';
import logoWhite from '@assets/logo/logo-white.png';

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-40">
  <!-- Barra de progreso de scroll -->
  <div id="scroll-progress" aria-hidden="true"></div>

  <div id="header-island">
    <div class="container-web">
      <div class="relative flex items-center h-16 md:h-18">

        <!-- Logo: centrado en mobile (absolute), izquierda en desktop (static) -->
        <a href="/" class="logo-link flex-shrink-0 flex items-center gap-3" aria-label={`${SITE.name} — Inicio`}>
          <span class="logo-img-wrap relative block w-16 h-16 md:w-11 md:h-11">
            <Image
              src={logoBlack}
              alt={SITE.name}
              width={64}
              height={64}
              class="logo-on-light absolute inset-0 w-full h-full object-contain select-none"
              loading="eager"
              decoding="async"
            />
            <Image
              src={logoWhite}
              alt=""
              aria-hidden="true"
              width={64}
              height={64}
              class="logo-on-dark absolute inset-0 w-full h-full object-contain select-none"
              loading="eager"
              decoding="async"
            />
          </span>
          <!-- Texto lockup: solo en desktop -->
          <span class="hidden md:flex flex-col leading-none select-none">
            <span class="logo-name font-display tracking-display uppercase text-xl leading-none">Diego Velicias</span>
            <span class="logo-sub text-xs font-sans uppercase tracking-wider mt-0.5">Electricista autorizado</span>
          </span>
        </a>

        <!-- Nav desktop -->
        <nav class="hidden md:flex items-center gap-0.5 mx-auto" aria-label="Navegación principal">
          {NAV.map((item) => (
            <a
              href={item.href}
              class:list={[
                'nav-link px-3.5 py-2 rounded-btn text-sm font-semibold',
                isActive(item.href) ? 'nav-link--active' : '',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <!-- CTA desktop + hamburger mobile (siempre a la derecha) -->
        <div class="ml-auto flex items-center gap-4">
          <a href={`tel:${SITE.phoneIntl}`} class="header-phone hidden md:flex items-center gap-1.5 text-sm font-bold">
            <Icon name="Phone" class="w-4 h-4" />
            {SITE.phone}
          </a>
          <Button href="/contacto" variant="primary" class="hidden md:inline-flex text-sm py-2.5 px-5">Presupuesto</Button>
          <button
            id="menu-toggle"
            class="menu-toggle md:hidden p-2 rounded-btn transition-colors"
            aria-label="Abrir menú"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <span id="icon-menu"><Icon name="Menu" class="w-6 h-6" /></span>
            <span id="icon-close" class="hidden"><Icon name="X" class="w-6 h-6" /></span>
          </button>
        </div>
      </div>
    </div>

    <!-- Nav móvil -->
    <div id="mobile-menu" class="mobile-menu-panel" data-open="false">
      <nav class="container-web pb-5 pt-2 flex flex-col gap-0.5" aria-label="Navegación móvil">
        {NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'mobile-nav-link px-3 py-3 rounded-btn text-base font-semibold transition-colors',
              isActive(item.href) ? 'mobile-nav-link--active' : '',
            ]}
          >
            {item.label}
          </a>
        ))}
        <a href={`tel:${SITE.phoneIntl}`} class="mobile-phone px-3 py-3 font-bold flex items-center gap-2">
          <Icon name="Phone" class="w-5 h-5 text-brand-yellow" /> {SITE.phone}
        </a>
        <div class="px-3 pt-1">
          <Button href="/contacto" variant="primary" class="w-full justify-center">Pide tu presupuesto</Button>
        </div>
      </nav>
    </div>
  </div>
</header>

<style>
  /* ─── Scroll progress bar ────────────────────────────────────── */
  #scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, #F7B904 0%, #D99F00 100%);
    transform-origin: left;
    transform: scaleX(0);
    z-index: 50;
  }

  /* ─── Isla principal ─────────────────────────────────────────── */
  #header-island {
    background-color: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    border-bottom: 1px solid #e5e5e5;
    margin: 0;
    border-radius: 0;
    box-shadow: none;
    transition:
      margin        0.5s cubic-bezier(0.4, 0, 0.2, 1),
      border-radius 0.5s cubic-bezier(0.4, 0, 0.2, 1),
      background    0.5s cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow    0.5s cubic-bezier(0.4, 0, 0.2, 1),
      border-color  0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #site-header.is-island #header-island {
    background-color: rgba(18, 18, 26, 0.92);
    backdrop-filter: blur(32px) saturate(200%);
    -webkit-backdrop-filter: blur(32px) saturate(200%);
    margin: 0.5rem 1rem;
    border-radius: 1rem;
    border-color: transparent;
    box-shadow:
      0 0 0 1px rgba(247, 185, 4, 0.25),
      0 4px 24px rgba(0, 0, 0, 0.3),
      0 24px 64px rgba(0, 0, 0, 0.5);
  }

  @media (max-width: 767px) {
    #site-header.is-island #header-island {
      margin: 0.4rem 0.6rem;
      border-radius: 0.875rem;
    }
  }

  /* ─── Logo cross-fade ────────────────────────────────────────── */
  .logo-link { transition: opacity 0.2s ease; }
  .logo-link:hover { opacity: 0.85; }

  .logo-on-light {
    opacity: 1;
    transition: opacity 0.4s ease;
  }
  .logo-on-dark {
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  #site-header.is-island .logo-on-light { opacity: 0; }
  #site-header.is-island .logo-on-dark  { opacity: 1; }

  /* ─── Logo texto lockup ──────────────────────────────────────── */
  .logo-name {
    color: #1A1A1A;
    transition: color 0.4s ease;
  }
  .logo-sub {
    color: #6B6B6B;
    transition: color 0.4s ease;
  }
  #site-header.is-island .logo-name { color: #ffffff; }
  #site-header.is-island .logo-sub  { color: rgba(255,255,255,0.55); }

  /* ─── Nav links desktop ──────────────────────────────────────── */
  .nav-link {
    color: #6B6B6B;
    position: relative;
    transition: color 0.25s ease, background-color 0.25s ease;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 14px;
    right: 14px;
    height: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 1px;
  }
  .nav-link:hover { color: #1A1A1A; }
  .nav-link:hover::after { transform: scaleX(1); }
  .nav-link--active { color: #1A1A1A; }
  .nav-link--active::after { transform: scaleX(1); }

  #site-header.is-island .nav-link         { color: rgba(255,255,255,0.6); }
  #site-header.is-island .nav-link:hover   { color: #F7B904; }
  #site-header.is-island .nav-link--active { color: #ffffff; }

  /* ─── Teléfono header ────────────────────────────────────────── */
  .header-phone {
    color: #1A1A1A;
    transition: color 0.25s ease;
  }
  .header-phone:hover { color: #D99F00; }

  #site-header.is-island .header-phone       { color: rgba(255,255,255,0.85); }
  #site-header.is-island .header-phone:hover { color: #F7B904; }

  /* ─── Toggle móvil ───────────────────────────────────────────── */
  .menu-toggle { color: #1A1A1A; }
  .menu-toggle:hover { background-color: #F2F2F2; }

  #site-header.is-island .menu-toggle       { color: #ffffff; }
  #site-header.is-island .menu-toggle:hover { background-color: rgba(255,255,255,0.1); }

  /* ─── Menú móvil animado ─────────────────────────────────────── */
  .mobile-menu-panel {
    border-top: 1px solid #E5E5E5;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition:
      max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      opacity    0.3s ease;
  }
  .mobile-menu-panel[data-open='true'] {
    max-height: 600px;
    opacity: 1;
  }

  #site-header.is-island .mobile-menu-panel {
    border-top-color: rgba(255,255,255,0.08);
  }

  .mobile-nav-link { color: #6B6B6B; }
  .mobile-nav-link:hover { color: #1A1A1A; background-color: #F2F2F2; }
  .mobile-nav-link--active { color: #1A1A1A; background-color: #F2F2F2; }

  #site-header.is-island .mobile-nav-link         { color: rgba(255,255,255,0.7); }
  #site-header.is-island .mobile-nav-link:hover   { color: #F7B904; background-color: rgba(255,255,255,0.07); }
  #site-header.is-island .mobile-nav-link--active { color: #ffffff; background-color: rgba(255,255,255,0.1); }

  .mobile-phone { color: #1A1A1A; }
  #site-header.is-island .mobile-phone { color: rgba(255,255,255,0.9); }

  /* Altura h-18 personalizada */
  .h-18 { height: 4.5rem; }
</style>

<script>
  import { initGsap, gsap, ScrollTrigger } from '@lib/gsap-init';

  initGsap();

  const siteHeader = document.getElementById('site-header') as HTMLElement | null;
  const progressBar = document.getElementById('scroll-progress') as HTMLElement | null;
  const THRESHOLD = 60;

  // ── Animación de isla ─────────────────────────────────────────
  if (siteHeader) {
    ScrollTrigger.create({
      start: THRESHOLD,
      end: THRESHOLD + 1,
      onEnter: () => siteHeader.classList.add('is-island'),
      onLeaveBack: () => siteHeader.classList.remove('is-island'),
    });
    if (window.scrollY > THRESHOLD) siteHeader.classList.add('is-island');
  }

  // ── Scroll progress bar ───────────────────────────────────────
  if (progressBar) {
    ScrollTrigger.create({
      start: 'top top',
      end: 'bottom bottom',
      onUpdate: (self) => {
        gsap.set(progressBar, { scaleX: self.progress });
      },
    });
  }

  // ── Menú móvil ────────────────────────────────────────────────
  const toggle   = document.getElementById('menu-toggle');
  const menu     = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose= document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const nowOpen = menu?.dataset.open !== 'true';
    if (menu) menu.dataset.open = String(nowOpen);
    toggle.setAttribute('aria-expanded', String(nowOpen));
    toggle.setAttribute('aria-label', nowOpen ? 'Cerrar menú' : 'Abrir menú');
    iconMenu?.classList.toggle('hidden', nowOpen);
    iconClose?.classList.toggle('hidden', !nowOpen);
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (menu) menu.dataset.open = 'false';
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Abrir menú');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
