---
import Layout from '@layouts/Layout.astro';
import Section from '@ui/Section.astro';
import Icon from '@ui/Icon.astro';
import Button from '@ui/Button.astro';
import Card from '@ui/Card.astro';
import CtaFinal from '@sections/CtaFinal.astro';
import { SERVICIOS, SITE } from '@data/site';
import { serviceSchema, breadcrumbSchema } from '@lib/seo';

export function getStaticPaths() {
  return SERVICIOS.map((s) => ({ params: { slug: s.slug }, props: { servicio: s } }));
}

const { servicio } = Astro.props;
const relacionados = SERVICIOS.filter((s) => s.slug !== servicio.slug).slice(0, 3);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? SITE.url;
const schema = serviceSchema(servicio, siteUrl);
const breadcrumb = breadcrumbSchema(
  [
    { name: 'Inicio', path: '/' },
    { name: 'Servicios', path: '/servicios' },
    { name: servicio.titulo, path: `/servicios/${servicio.slug}` },
  ],
  siteUrl
);
---

<Layout
  title={servicio.titulo}
  description={`${servicio.resumen} Electricista autorizado en ${SITE.coverageLabel}. ${SITE.name}.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  <!-- Cabecera del servicio -->
  <Section bg="black">
    <nav class="flex items-center gap-2 text-sm text-brand-gray-border/60 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-yellow transition-colors">Inicio</a>
      <Icon name="ChevronRight" class="w-4 h-4" />
      <a href="/servicios" class="hover:text-brand-yellow transition-colors">Servicios</a>
      <Icon name="ChevronRight" class="w-4 h-4" />
      <span class="text-brand-white">{servicio.titulo}</span>
    </nav>

    <div class="grid md:grid-cols-2 gap-10 items-center">
      <div>
        <span class="grid place-items-center w-16 h-16 rounded-card bg-brand-yellow mb-6">
          <Icon name={servicio.icon} class="w-8 h-8 text-brand-black" />
        </span>
        <h1 class="text-display-lg">{servicio.titulo}</h1>
        <p class="mt-5 text-lg text-brand-gray-border/80 max-w-lg leading-relaxed">
          {servicio.descripcion}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/contacto" variant="primary" icon="FileText">Pide presupuesto</Button>
          <Button href={`tel:${SITE.phoneIntl}`} variant="outline" class="border-brand-white/30 text-brand-white hover:bg-brand-white hover:text-brand-black" icon="Phone">
            {SITE.phone}
          </Button>
        </div>
      </div>
      <div class="hidden md:block">
        <ul class="space-y-3">
          {servicio.puntos.map((p) => (
            <li class="flex items-start gap-3 bg-brand-white/5 rounded-card px-5 py-4">
              <Icon name="CheckCircle2" class="w-5 h-5 text-brand-yellow flex-shrink-0 mt-0.5" />
              <span class="text-brand-white font-semibold">{p}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <!-- Puntos (móvil, repetimos en layout limpio) -->
  <Section bg="gray">
    <div class="grid md:grid-cols-2 gap-12 items-start">
      <div>
        <h2 class="text-display-md">¿Qué incluye este servicio?</h2>
        <span class="accent-bar mt-3"></span>
        <ul class="mt-8 space-y-4">
          {servicio.puntos.map((p) => (
            <li class="flex items-start gap-3">
              <Icon name="CheckCircle2" class="w-5 h-5 text-brand-yellow-dark flex-shrink-0 mt-0.5" />
              <span class="font-semibold">{p}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="card p-8">
        <h3 class="text-display-sm mb-4">¿Necesitas este servicio?</h3>
        <p class="text-sm text-brand-gray leading-relaxed mb-6">
          Cuéntame qué necesitas y te paso presupuesto sin compromiso.
          Trabajo en {SITE.coverageArea}.
        </p>
        <Button href="/contacto" variant="primary" class="w-full justify-center" icon="FileText">
          Pide presupuesto gratis
        </Button>
        <a
          href={`tel:${SITE.phoneIntl}`}
          class="mt-3 flex items-center justify-center gap-2 text-sm font-bold text-brand-black hover:text-brand-yellow-dark transition-colors"
        >
          <Icon name="Phone" class="w-4 h-4" /> {SITE.phone}
        </a>
      </div>
    </div>
  </Section>

  <!-- Servicios relacionados -->
  {relacionados.length > 0 && (
    <Section bg="white">
      <h2 class="text-display-md">Otros servicios</h2>
      <span class="accent-bar mt-3"></span>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {relacionados.map((r) => (
          <Card as="a" href={`/servicios/${r.slug}`} class="flex flex-col group">
            <span class="grid place-items-center w-12 h-12 rounded-card bg-brand-yellow-soft mb-3 transition-colors group-hover:bg-brand-yellow">
              <Icon name={r.icon} class="w-6 h-6 text-brand-yellow-dark group-hover:text-brand-black transition-colors" />
            </span>
            <h3 class="text-display-sm">{r.titulo}</h3>
            <p class="mt-1.5 text-sm text-brand-gray flex-1">{r.resumen}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-yellow-dark group-hover:gap-2 transition-all">
              Ver más <Icon name="ArrowRight" class="w-4 h-4" />
            </span>
          </Card>
        ))}
      </div>
    </Section>
  )}

  <CtaFinal />
</Layout>
