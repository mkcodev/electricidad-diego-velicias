---
import Layout from '@layouts/Layout.astro';
import Section from '@ui/Section.astro';
import SectionHeading from '@ui/SectionHeading.astro';
import Icon from '@ui/Icon.astro';
import Button from '@ui/Button.astro';
import CtaFinal from '@sections/CtaFinal.astro';
import { ZONAS, ZONAS_INFO, SITE } from '@data/site';
---

<Layout
  title="Zona de cobertura: electricista en Zamora y León"
  description={`Electricista en ${ZONAS.slice(0, 3).join(', ')} y comarca de Benavente. ${SITE.name} se desplaza por Zamora y León.`}
>
  <Section bg="black">
    <div class="max-w-2xl">
      <p class="eyebrow text-brand-yellow">Zona de cobertura</p>
      <h1 class="text-display-lg mt-3">Electricista en la comarca de Benavente y alrededores</h1>
      <p class="mt-5 text-lg text-brand-gray-border/80 leading-relaxed">
        Me desplazo por municipios de las provincias de <strong>Zamora</strong> y <strong>León</strong>.
        Si tienes dudas sobre si llego a tu zona, pregúntame directamente — sin compromiso.
      </p>
    </div>
  </Section>

  <Section bg="white">
    <div class="grid md:grid-cols-2 gap-12 items-start">
      <div>
        <SectionHeading eyebrow="Municipios" title="¿Dónde trabajo?" />
        <p class="mt-4 text-brand-gray leading-relaxed">
          A continuación encontrarás una lista de los principales municipios en los que ofrezco
          mis servicios de electricidad. La lista no es exhaustiva: si no ves tu pueblo,
          llámame y lo comprobamos.
        </p>
        <ul class="mt-8 grid grid-cols-2 gap-2">
          {ZONAS.map((zona) => (
            <li class="flex items-center gap-2 text-sm font-semibold py-2 px-3 rounded-btn
                        bg-brand-gray-light hover:bg-brand-yellow-soft transition-colors">
              <Icon name="MapPin" class="w-4 h-4 text-brand-yellow-dark flex-shrink-0" />
              {zona}
            </li>
          ))}
        </ul>
        <p class="mt-6 text-sm text-brand-gray">
          ¿Tu municipio no aparece?{' '}
          <a href="/contacto" class="font-semibold text-brand-black underline hover:text-brand-yellow-dark transition-colors">
            Consúltame sin compromiso
          </a>.
        </p>
      </div>

      <div class="card p-8">
        <div class="flex items-center gap-3 mb-5">
          <span class="grid place-items-center w-12 h-12 rounded-full bg-brand-black">
            <Icon name="MapPin" class="w-6 h-6 text-brand-yellow" />
          </span>
          <div>
            <p class="font-bold">Radio de desplazamiento</p>
            <p class="text-sm text-brand-gray">Comarca de Benavente</p>
          </div>
        </div>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start gap-2">
            <Icon name="CheckCircle2" class="w-4 h-4 text-brand-yellow-dark flex-shrink-0 mt-0.5" />
            <span>Desplazamiento rápido por toda la comarca</span>
          </li>
          <li class="flex items-start gap-2">
            <Icon name="CheckCircle2" class="w-4 h-4 text-brand-yellow-dark flex-shrink-0 mt-0.5" />
            <span>Provincias de Zamora y León</span>
          </li>
          <li class="flex items-start gap-2">
            <Icon name="CheckCircle2" class="w-4 h-4 text-brand-yellow-dark flex-shrink-0 mt-0.5" />
            <span>Consulta disponibilidad para tu municipio</span>
          </li>
        </ul>
        <Button href="/contacto" variant="primary" class="mt-6 w-full justify-center" icon="Phone">
          Consulta disponibilidad
        </Button>
      </div>
    </div>
  </Section>

  <!-- Bloque SEO: un párrafo único por municipio (long-tail "electricista en X") -->
  <Section bg="gray">
    <div class="max-w-4xl mx-auto">
      <SectionHeading eyebrow="SEO Local" title="Electricista en cada municipio de la zona" center />
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {ZONAS_INFO.map((z) => (
          <div id={z.slug} class="card p-6">
            <h3 class="text-display-sm flex items-center gap-2">
              <Icon name="MapPin" class="w-5 h-5 text-brand-yellow-dark flex-shrink-0" />
              Electricista en {z.nombre}
            </h3>
            <p class="mt-3 text-sm md:text-base text-brand-gray leading-relaxed">{z.texto}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 text-sm text-brand-gray text-center max-w-2xl mx-auto">
        Todos mis trabajos cumplen con la normativa eléctrica vigente y van acompañados de la
        documentación oficial necesaria para contratar el suministro o tramitar el boletín eléctrico.
      </p>
    </div>
  </Section>

  <CtaFinal />
</Layout>
